# --- Hosting cruft (Váš-hosting) ---
/tmp/
/stats/
/_

# --- Generované nabídky (mimo git; privacy = nehádatelný GUID) ---
# Ignoruj vše ve www/ kromě sdílených brand assetů, publikovaných skillů a robots.txt
/www/*
!/www/_assets/
!/www/brand/
!/www/robots.txt

# --- OS / editor ---
.DS_Store
Thumbs.db
*.swp
*~

# --- Lokální / citlivé ---
.env
*.local

# --- Vstupní materiály (intake) — mimo git kromě README ---
/podklady/*
!/podklady/README.md

# --- Index nabídek (klientská data) — mimo git ---
/NABIDKY-INDEX.md
